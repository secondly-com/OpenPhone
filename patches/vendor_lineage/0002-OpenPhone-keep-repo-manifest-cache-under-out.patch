From 4a3ddc8625d6f54b6a272b37684d2278e919b7c1 Mon Sep 17 00:00:00 2001
From: OpenPhone <dev@openphone.local>
Date: Fri, 26 Jun 2026 15:10:00 -0700
Subject: [PATCH] OpenPhone: keep repo manifest cache under out

Android's build runs source actions under a read-only guard. The Lineage build
manifest rule invokes repo from inside that guard; repo may create a Git config
JSON cache next to the user Git config. On clean build hosts this lands under
$HOME as .repo_.gitconfig.json, which is outside the rule output and can be
blocked as a read-only write.

Run the manifest invocation with HOME pointed at a rule-owned directory under
PRODUCT_OUT so repo's cache stays in writable build output.
---
 build/tasks/build-manifest_xml.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/build/tasks/build-manifest_xml.mk b/build/tasks/build-manifest_xml.mk
index 5f54967..ecf6d83 100644
--- a/build/tasks/build-manifest_xml.mk
+++ b/build/tasks/build-manifest_xml.mk
@@ -21,3 +21,4 @@ $(INSTALLED_BUILD_MANIFEST_XML_TARGET):
-	REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
-
+	mkdir -p $(PRODUCT_OUT)/obj/PACKAGING/build_manifest_intermediates/home
+	HOME=$(abspath $(PRODUCT_OUT)/obj/PACKAGING/build_manifest_intermediates/home) REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
+
 .PHONY: build-manifest.xml
