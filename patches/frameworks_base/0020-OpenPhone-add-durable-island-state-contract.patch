+        private static final int MAX_ISLAND_STATE_BYTES = 16 * 1024;
+        private static final String ISLAND_STATE_SCHEMA = "openphone.island_state.v1";
+        private static final String ASSISTANT_PACKAGE = "org.openphone.assistant";
+        private static final Set<String> ALLOWED_ISLAND_MODES = Set.of(
+                "idle", "listening", "transcript", "thinking", "realtime",
+                "action_running", "answer_ready", "reply", "needs_review",
+                "error", "watching", "unavailable");
