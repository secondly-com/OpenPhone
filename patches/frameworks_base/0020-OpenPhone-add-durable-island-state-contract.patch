+    /**
+     * Return the latest normalized compact-island projection held by
+     * system_server.
+     *
+     * @hide
+     */
+    @NonNull
+    public String getIslandState() {
+        try {
+            return mService.getIslandState();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Publish a bounded compact-island projection. Only the OpenPhone
+     * assistant package may publish; system_server normalizes the payload,
+     * assigns its revision and timestamps, and discards unknown fields.
+     *
+     * @hide
+     */
+    @NonNull
+    public String publishIslandState(@NonNull String stateJson) {
+        try {
+            return mService.publishIslandState(stateJson);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** @hide */
