<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openphone.agentd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/var/jb/usr/local/bin/openphone-agentd</string>
  </array>
  <key>UserName</key>
  <string>mobile</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/mobile/Library/OpenPhone/openphone-agentd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/var/mobile/Library/OpenPhone/openphone-agentd.stderr.log</string>
  <key>WorkingDirectory</key>
  <string>/var/mobile</string>
</dict>
</plist>
